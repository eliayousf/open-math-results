import Mathlib

/-!
# OEIS A055938: a self-referential recursion for the complement of A005187

Source: https://oeis.org/A055938
Credit: @sntntHb

A055938: integers not generated by `b(n) = b(floor(n/2)) + n` (complement of A005187)
(offset 1: 2, 5, 6, 9, 12, 13, 14, 17, 20, 21, 24, ...). Here A005187 is
`c(0) = 0, c(n) = c(floor(n/2)) + n`, with values 0, 1, 3, 4, 7, 8, 10, 11, 15, ...

Conjecture (Ralf Stephan, Dec 27 2013): `a(n) = b(n)` where `b(1) = 2` and, for `n > 1`,
`b(n+1) = b(n) + 1` if `n` is already in the sequence, `b(n+1) = b(n) + 3` otherwise.

Formalized: `c` is A005187, `S` is the set of positive integers outside the range of `c` (the
terms of A055938), so `a(n) = Nat.nth (· ∈ S) (n - 1)`. `b` is the recursion above, with
`b(n+1)` decided by whether `n ∈ S` (Stephan writes `n > 1`; for `n = 1` both rules give
`b(2) = 5`, since `1` is not in the sequence). `main` states `b n = a(n)` for every `n >= 1`.
-/

namespace OMA.S_oeis_a055938

/-- A005187: `c(0) = 0`, `c(n) = c(floor(n/2)) + n`. -/
def c : ℕ → ℕ
  | 0 => 0
  | n + 1 => c ((n + 1) / 2) + (n + 1)

/-- The terms of A055938: positive integers that are not values of `c`. -/
def S : Set ℕ := {m | 0 < m ∧ m ∉ Set.range c}

open Classical in
/-- Stephan's recursion: `b(1) = 2`, `b(n+1) = b(n) + 1` if `n ∈ S`, else `b(n) + 3`. -/
noncomputable def b : ℕ → ℕ
  | 0 => 0
  | 1 => 2
  | n + 2 => if n + 1 ∈ S then b (n + 1) + 1 else b (n + 1) + 3

theorem main : ∀ n : ℕ, 1 ≤ n → b n = Nat.nth (fun m => m ∈ S) (n - 1) := by
  sorry

end OMA.S_oeis_a055938
