private theorem table_step : ∀ j : Fin 11, entries *ᵥ table j.castSucc = table j.succ := by
  decide +kernel

private theorem table_match (n : ℕ) (hn : n ≤ 11) :
    state n = table ⟨n, by omega⟩ := by
  induction n with
  | zero => exact table_initial
  | succ n ih =>
    rw [state_succ, ih (by omega), ← entries_match]
    exact table_step ⟨n,by omega⟩

private theorem base_vec :
    table 11 = (103 : ℤ) • table 10 + (1063 : ℤ) • table 9 - (1873 : ℤ) • table 8
      - (20274 : ℤ) • table 7 + (44071 : ℤ) • table 6 - (10365 : ℤ) • table 5
      - (20208 : ℤ) • table 4 + (5959 : ℤ) • table 3 + (2300 : ℤ) • table 2
      - (500 : ℤ) • table 1 := by decide +kernel

private theorem state_recurrence (k : ℕ) :
    state (k + 11) = (103 : ℤ) • state (k + 10) + (1063 : ℤ) • state (k + 9) - (1873 : ℤ) • state (k + 8)
      - (20274 : ℤ) • state (k + 7) + (44071 : ℤ) • state (k + 6) - (10365 : ℤ) • state (k + 5)
      - (20208 : ℤ) • state (k + 4) + (5959 : ℤ) • state (k + 3) + (2300 : ℤ) • state (k + 2)
      - (500 : ℤ) • state (k + 1) := by
  induction k with
  | zero =>
    simp only [Nat.zero_add]
    rw [table_match 11 (by omega), table_match 10 (by omega), table_match 9 (by omega), table_match 8 (by omega), table_match 7 (by omega), table_match 6 (by omega), table_match 5 (by omega), table_match 4 (by omega), table_match 3 (by omega), table_match 2 (by omega), table_match 1 (by omega)]
    exact base_vec
  | succ k ih =>
    have h := congrArg (fun v : Fin 32 → ℤ => transfer *ᵥ v) ih
    simp only [Matrix.mulVec_add, Matrix.mulVec_sub, Matrix.mulVec_smul,
      ← state_succ] at h
    simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using h

theorem recurrence (n : ℕ) (hn : 11 ≤ n) :
    a n = 103 * a (n - 1) + 1063 * a (n - 2) - 1873 * a (n - 3)
      - 20274 * a (n - 4) + 44071 * a (n - 5) - 10365 * a (n - 6)
      - 20208 * a (n - 7) + 5959 * a (n - 8) + 2300 * a (n - 9)
      - 500 * a (n - 10) := by
  obtain ⟨k,rfl⟩ : ∃ k : ℕ, n = k + 11 := ⟨n - 11, by omega⟩
  rw [show k + 11 - 1 = k + 10 by omega, show k + 11 - 2 = k + 9 by omega, show k + 11 - 3 = k + 8 by omega, show k + 11 - 4 = k + 7 by omega, show k + 11 - 5 = k + 6 by omega, show k + 11 - 6 = k + 5 by omega, show k + 11 - 7 = k + 4 by omega, show k + 11 - 8 = k + 3 by omega, show k + 11 - 9 = k + 2 by omega, show k + 11 - 10 = k + 1 by omega]
  have hh := congrFun (state_recurrence k) (0 : Fin 32)
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply] at hh
  simpa [a, zsmul_eq_mul] using hh

